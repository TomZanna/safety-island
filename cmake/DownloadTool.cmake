# cmake -DURL=... -DSHA256=... -DDEST=<dir> -DEXE=<nome> -P DownloadTool.cmake
# Scarica un archivio, ne verifica lo sha256, estrae e mette l'eseguibile in <DEST>/<EXE>.
foreach(v URL SHA256 DEST EXE)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "DownloadTool: manca -D${v}")
    endif()
endforeach()

get_filename_component(name "${URL}" NAME)
set(archive "${DEST}/${name}")
file(DOWNLOAD "${URL}" "${archive}" EXPECTED_HASH SHA256=${SHA256} STATUS st TLS_VERIFY ON)
list(GET st 0 code)
if(NOT code EQUAL 0)
    file(REMOVE "${archive}")
    message(FATAL_ERROR "download di ${URL} fallito: ${st}")
endif()

set(tmp "${DEST}/_extract")
file(REMOVE_RECURSE "${tmp}")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${tmp}")
file(GLOB_RECURSE found "${tmp}/*/${EXE}" "${tmp}/${EXE}")
list(LENGTH found n)
if(NOT n EQUAL 1)
    message(FATAL_ERROR "${EXE} non trovato (o ambiguo) in ${name}: ${found}")
endif()
file(COPY_FILE "${found}" "${DEST}/${EXE}")
file(CHMOD "${DEST}/${EXE}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
file(REMOVE_RECURSE "${tmp}")
file(REMOVE "${archive}")
