# cmake -DURL=... -DSHA256=... -DDEST=<dir> -DEXE=<nome> [-DRAW=1] [-DKEEP_TREE=1] -P DownloadTool.cmake
# Scarica un archivio, ne verifica lo sha256, estrae e mette l'eseguibile in <DEST>/<EXE>.
#   RAW=1:       l'URL e' gia' l'eseguibile (niente estrazione)
#   KEEP_TREE=1: estrae l'archivio in <DEST> cosi' com'e' (toolchain); EXE e' il percorso relativo atteso
foreach(v URL SHA256 DEST EXE)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "DownloadTool: manca -D${v}")
    endif()
endforeach()

get_filename_component(name "${URL}" NAME)
if(RAW)
    file(DOWNLOAD "${URL}" "${DEST}/${EXE}.part" EXPECTED_HASH SHA256=${SHA256} STATUS st TLS_VERIFY ON)
    list(GET st 0 code)
    if(NOT code EQUAL 0)
        file(REMOVE "${DEST}/${EXE}.part")
        message(FATAL_ERROR "download di ${URL} fallito: ${st}")
    endif()
    file(RENAME "${DEST}/${EXE}.part" "${DEST}/${EXE}")
    file(CHMOD "${DEST}/${EXE}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    return()
endif()
set(archive "${DEST}/${name}")
file(DOWNLOAD "${URL}" "${archive}" EXPECTED_HASH SHA256=${SHA256} STATUS st TLS_VERIFY ON)
list(GET st 0 code)
if(NOT code EQUAL 0)
    file(REMOVE "${archive}")
    message(FATAL_ERROR "download di ${URL} fallito: ${st}")
endif()

if(KEEP_TREE)
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${DEST}")
    file(REMOVE "${archive}")
    if(NOT EXISTS "${DEST}/${EXE}")
        message(FATAL_ERROR "${EXE} non trovato dopo l'estrazione di ${name}")
    endif()
    return()
endif()
set(tmp "${DEST}/_extract")
file(REMOVE_RECURSE "${tmp}")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${tmp}")
file(GLOB_RECURSE found "${tmp}/*/${EXE}" "${tmp}/${EXE}")
list(LENGTH found n)
if(NOT n EQUAL 1)
    message(FATAL_ERROR "${EXE} non trovato (o ambiguo) in ${name}: ${found}")
endif()
file(COPY_FILE "${found}" "${DEST}/${EXE}")
file(CHMOD "${DEST}/${EXE}" FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
file(REMOVE_RECURSE "${tmp}")
file(REMOVE "${archive}")
