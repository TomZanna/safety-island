---
# Profilo C per il firmware bare-metal. Non e' il "*" generico: le regole
# C++ (modernize/cppcoreguidelines/fuchsia) e il naming C++ producono solo
# rumore su questo codice. Le eccezioni vanno motivate con NOLINT nel punto.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-branch-clone,
  -misc-include-cleaner,
  -misc-unused-parameters,
  -misc-non-private-member-variables-in-classes,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
WarningsAsErrors: ''
HeaderFilterRegex: '^(.*/)?fw/(common|safe|fieldbus)/'
CheckOptions:
  - key: 'bugprone-argument-comment.StrictMode'
    value: 'true'
  - key: 'bugprone-misplaced-widening-cast.CheckImplicitCasts'
    value: 'true'
  - key: 'bugprone-sizeof-expression.WarnOnSizeOfIntegerExpression'
    value: 'true'
  - key: 'bugprone-suspicious-string-compare.WarnOnLogicalNotComparison'
    value: 'true'
...
